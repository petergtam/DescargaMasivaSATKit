{"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"DescargaMasivaSATKit provides a set of features that allows you to use the Descargas Masivas service from the SAT. The framework porpuse is to provide an easy way for developers to use the service using Swift.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The framework provides two major features.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The first feature is a tool for creating signatures using the private key of the e.firma and consulting the information of the certificate of the e.firma.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The second feature is a collection of objects that allows you to use each part of the Descargas Masivas service:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The authentication request"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The query request"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The verification request"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The download request"}],"type":"paragraph"}]}]},{"type":"aside","content":[{"inlineContent":[{"text":"This framework is intended for developers working for customers in México","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note"},{"type":"aside","content":[{"inlineContent":[{"text":"Take a look at each of the documents from the SAT","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/ampocdevbuk01a.s3.us-east-1.amazonaws.com\/0_UR_Ls_WS_Descarga_Masiva_V1_5_VF_33e2cca681.pdf"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/ampocdevbuk01a.s3.us-east-1.amazon